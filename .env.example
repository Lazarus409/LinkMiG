# Copy to .env.local and fill in. Used by app/api/contact/route.ts.

# SMTP server. For Gmail: smtp.gmail.com, port 465, and an App Password
# (Google Account > Security > 2-Step Verification > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-app-password

# Optional: sender shown on notification emails (defaults to SMTP_USER)
# SMTP_FROM="Link MiG Website <your-account@gmail.com>"

# Optional: inbox that receives bookings (defaults to info@linkmig.com from lib/site.ts)
# CONTACT_TO_EMAIL=info@linkmig.com
